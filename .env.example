DATABASE_URL=postgres://postgres:yourpassword@127.0.0.1:5432/aracze
PAYLOAD_SECRET=YOUR_SECRET_HERE
CLOUDINARY_CLOUD_NAME=<cloudinary_cloud_name>
CLOUDINARY_API_KEY=<cloudinary_api_key>
CLOUDINARY_API_SECRET=<cloudinary_api_secret>
S3_ENDPOINT=<s3_endpoint>
S3_BUCKET=<s3_bucket>
S3_ACCESS_KEY_ID=<s3_access_key_id>
S3_SECRET=<s3_secret>

# Produkční Cloudinary účet – používá JEN zálohovací skript `scripts/backup-r2.ts`.
# Do R2 se zálohují jen obrázky z tohoto účtu; lokálně nahrané obrázky (dev účet
# v CLOUDINARY_CLOUD_NAME) se přeskočí. Default (bez nastavení): "ara".
# PROD_CLOUDINARY_CLOUD_NAME=ara

# Mapy na webu: OpenStreetMap přes MapLibre + OpenFreeMap — bez klíče a bez
# limitů; barevný styl generuje `node scripts/build-map-style.mjs`.
# (Google Maps klíč už web nepoužívá — odstraněno 8/2026.)

# OpenWeather – serverový klíč, do prohlížeče NEprochází.
# Živé počasí na stránkách Počasí (src/lib/weather.ts). Účet openweathermap.org
# → Billing plans → „One Call API 3.0" → Subscribe. Předplatné se jmenuje
# „One Call by Call".
# Prvních 1 000 volání denně je zdarma, další se účtují (0,14 EUR/100), proto
# v účtu nech „calls per day (no more than)" = 1000: strop se nepřekročí a nic
# se nefakturuje. Bez předplatného web spadne na
# bezplatné endpointy /data/2.5/* a ukáže 6denní předpověď místo 7denní.
OPENWEATHER_API_KEY=<openweather_api_key>

# SMTP pro odesílání e-mailů z administrace (reset hesla). Bez SMTP_HOST se
# e-maily jen vypíšou do konzole (žádné odesílání). Původní web používal Zoho.
SMTP_HOST=smtp.zoho.com
SMTP_PORT=465
SMTP_USER=<smtp_username>
SMTP_PASSWORD=<smtp_password>
SMTP_FROM=info@ara.cz

# Veřejná URL webu (sitemap, kanonické odkazy). Default https://www.ara.cz.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Base URL pro absolutní URL obrázků (loga, avatary, sdílení). Dostupné i v prohlížeči.
NEXT_PUBLIC_PAYLOAD_BASE_URL=http://localhost:3000

# Google AdSense (reklamní bloky v článcích) – volitelné.
NEXT_PUBLIC_ADSENSE_CLIENT=<adsense_client_id>
NEXT_PUBLIC_ADSENSE_ARTICLE_SLOT=<adsense_slot_id>
NEXT_PUBLIC_ADSENSE_ARTICLE_SLOT_2=<adsense_slot_id_2>

# Google Analytics 4 – volitelné, v kódu je fallback na produkční ID.
# Měření běží JEN v produkci a jen se souhlasem z lišty Funding Choices
# (viz components/features/analytics.tsx).
NEXT_PUBLIC_GA_MEASUREMENT_ID=<ga4_measurement_id>

# Media proxy (Cloudflare Worker, workers/media-proxy) – JEN PRODUKCE.
# Když je nastavené, frontend přepisuje emitované adresy fotek
# z res.cloudinary.com/ara/... na tuto základnu (šetří Cloudinary kredity,
# při výpadku Cloudinary podává zálohu z R2). V dev NEnastavovat – proxy
# nezná dev Cloudinary cloud a adresy by vedly do prázdna.
# NEXT_PUBLIC_MEDIA_BASE_URL=https://media.ara.cz

# Cloudflare Turnstile – ochrana formuláře komentářů proti spamu (volitelné).
# Oba klíče čte SERVER za běhu (site key se klientovi předává přes prop, proto
# NENÍ NEXT_PUBLIC_ a nevyžaduje rebuild). Turnstile se zapne JEN když jsou
# nastavené OBA klíče; při neúplné/žádné konfiguraci jede honeypot + rate-limit.
# Klíče získáš na dash.cloudflare.com → Turnstile.
TURNSTILE_SECRET_KEY=<turnstile_secret_key>
TURNSTILE_SITE_KEY=<turnstile_site_key>

# Google Analytics 4 Data API – noční sync návštěvnosti do pole `analyticsPageViews`
# (endpoint /api/sync-analytics, viz src/endpoints/syncAnalytics.ts). Service account
# JEN s Viewer přístupem v GA4 Property Access Management, žádná GCP IAM role.
GA4_PROPERTY_ID=<ga4_property_id>
GA4_SERVICE_ACCOUNT_JSON=<ga4_service_account_json_jednoradkove>
# Sdílené tajemství pro GitHub Actions cron, který endpoint spouští (žádná session).
# Sdílí ho i sync akčních nabídek (/api/sync-affiliate-deals).
ANALYTICS_SYNC_SECRET=<random_secret>

# Kiwi Tequila Search API — denní sync akčních nabídek (/api/sync-affiliate-deals,
# viz src/endpoints/syncAffiliateDeals.ts). Účet je schválený partner z 2023;
# od 5/2024 Tequila nové partnery nebere, takže klíč nerušit. Na produkci musí
# být i v deploy/docker-compose.yml (compose proměnné vyjmenovává).
KIWI_TEQUILA_API_KEY=<kiwi_tequila_api_key>

# Meteostat – sync dlouhodobých průměrů pro sekci „Nejlepší doba na cestu…"
# na stránkách počasí (endpoint /api/sync-climate-normals, viz
# src/endpoints/syncClimateNormals.ts). Klíč: rapidapi.com → přihlásit se →
# vyhledat „Meteostat" → Subscribe (plán Basic, zdarma, 500 dotazů/měsíc;
# jedno místo stojí 2 dotazy)
# → zkopírovat X-RapidAPI-Key. Data jsou CC BY 4.0 (web uvádí „Zdroj: Meteostat").
# Na produkci musí být i v deploy/docker-compose.yml (compose proměnné vyjmenovává).
METEOSTAT_RAPIDAPI_KEY=<x_rapidapi_key>

# PG_DUMP_DOCKER_SERVICE=postgres
# PG_DUMP_DOCKER_HOST=localhost
# PG_DUMP_DOCKER_CONTAINER=postgres-1

# --- Stará databáze webu (Grails + MySQL) ---
# Migrace obsahu je DOKONČENÁ a její skripty byly odstraněné, takže v běžném
# provozu tyhle proměnné nikdo nečte. Připojení ale ZÁMĚRNĚ zůstává popsané:
# stará databáze pořád existuje a je jediný zdroj věcí, které se do nového webu
# nepřenesly (pírka a spolupráce jako systém, hodnocení afiliací, statistiky
# návštěv…). Kdyby se něco dotahovalo, stačí doplnit hodnoty a připojit se.
#
# Skripty, které z ní čtou (znají názvy tabulek a mapování polí), najdeš v git
# historii — smazal je commit b745d2c, takže třeba:
#   git show b745d2c^:scripts/migrate-pages.ts
# Popis starého schématu a chování je v `grails/AI_MIGRATION_SOURCE.md` (ten
# jediný soubor JE v repu; zbytek složky `grails/` je git-ignored, jen lokálně).
# OLD_DB_HOST=
# OLD_DB_PORT=3306
# OLD_DB_USER=
# OLD_DB_PASSWORD=
# OLD_DB_NAME=
